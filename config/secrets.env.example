# Copy this file to config\secrets.env and fill in your own values. Never commit secrets.env.
# One variable per line: NAME=VALUE  (quotes optional). A pasted  setx NAME "VALUE"  line also works.
# The bots load this file at startup; a value here wins over a setx value already in Windows.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=sk-proj-...
OPENAI_GOLD_AGENT_ID=agent_...
TELEGRAM_BOT_TOKEN=1234567890:AA...
TELEGRAM_CHAT_ID=@XAU_USD_Bot_Analysis
TELEGRAM_CHAT_ANALYSIS=@XAU_USD_Bot_Analysis
TELEGRAM_CHAT_SIGNALS=@XAU_USD_Bot_Trading
TELEGRAM_CHAT_LOG=@XAU_USD_Bot_Log
TELEGRAM_ADMIN_IDS=123456789        # your Telegram user id(s), comma-separated: who may send /idea plans
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
TRADER_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Historical providers (only if still used by your config):
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
EODHD_API_KEY=
